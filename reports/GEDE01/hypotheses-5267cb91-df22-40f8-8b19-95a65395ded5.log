Hypothesis 1: member accessor inlining postpones address folding.
Source:
typedef unsigned int u32;

typedef struct Vec3Words {
    u32 x;
    u32 y;
    u32 z;
} Vec3Words;

typedef struct State {
    Vec3Words first[10];
    Vec3Words second[10];
    u32 values[10];
} State;

extern State lbl_80303A18;
extern int lbl_8064C710;

/* Keep member access in local C accessors, as in an inlined state API. */
static Vec3Words* firstArray(State* state) { return state->first; }
static Vec3Words* secondArray(State* state) { return state->second; }
static u32* valueArray(State* state) { return state->values; }

void fn_8002B5B4(Vec3Words* first, Vec3Words* second, int index, u32 value)
{
    firstArray(&lbl_80303A18)[index] = *first;
    secondArray(&lbl_80303A18)[index] = *second;
    valueArray(&lbl_80303A18)[index] = value;
    lbl_8064C710 = index;
}

