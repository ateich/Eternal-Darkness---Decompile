Hypothesis 2: integer address arithmetic retains member bases across pointer conversions.
Source:
typedef unsigned int u32;

typedef struct Vec3Words {
    u32 x;
    u32 y;
    u32 z;
} Vec3Words;

typedef struct State {
    Vec3Words first[10];
    Vec3Words second[10];
    u32 values[10];
} State;

extern State lbl_80303A18;
extern int lbl_8064C710;

/* Form member addresses in the integer address domain before indexing. */
void fn_8002B5B4(Vec3Words* first, Vec3Words* second, int index, u32 value)
{
    u32 base = (u32)&lbl_80303A18;
    u32 offset = index * sizeof(Vec3Words);
    *(Vec3Words*)(base + offset) = *first;
    *(Vec3Words*)((base + 0x78) + offset) = *second;
    *(u32*)((base + 0xF0) + index * sizeof(u32)) = value;
    lbl_8064C710 = index;
}

